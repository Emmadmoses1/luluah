# Supabase session pooler connection string (Project > Connect). Never commit the real one.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Free key from https://pixabay.com/api/docs/ (used only by npm run images:download)
PIXABAY_API_KEY="your-pixabay-key"

# Public address of the site, no trailing slash (used for payment callbacks and emails)
SITE_URL="https://your-service.onrender.com"
# Crypto payments (NOWPayments). Leave empty to keep payments disabled.
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
# Sandbox for testing: https://api-sandbox.nowpayments.io/v1  (default is live)
NOWPAYMENTS_API_URL=""
# Set to 1 ONLY when going live; until then every order is marked as a test order
PAYMENTS_LIVE=""
# Optional email (resend.com). Without these no email is sent.
RESEND_API_KEY=""
EMAIL_FROM="لؤلؤة <orders@your-domain.com>"
ADMIN_NOTIFY_EMAIL=""
